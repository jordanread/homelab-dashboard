@* One tap-target on the Admiral's Quick Start grid. *@

<a href="@Href" target="@(External ? "_blank" : null)" class="admiral-card">
    <div class="admiral-card-icon">@Icon</div>
    <div class="admiral-card-name">@Name</div>
    <div class="admiral-card-desc">@Description</div>
</a>

@code {
    [Parameter, EditorRequired] public required string Href { get; set; }
    [Parameter, EditorRequired] public required string Icon { get; set; }
    [Parameter, EditorRequired] public required string Name { get; set; }
    [Parameter, EditorRequired] public required string Description { get; set; }
    [Parameter] public bool External { get; set; } = true;
}
