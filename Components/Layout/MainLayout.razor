@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<nav class="nav">
    <a href="/" class="nav-brand">
        <span class="anchor-icon">⚓</span>
        The Hold
    </a>

    @if (IsHome)
    {
        <ul class="nav-links">
            <li><a href="#stats" data-nav="stats">Ship's Log</a></li>
            <li><a href="#services" data-nav="services">Deck</a></li>
            <li><a href="#admiral" data-nav="admiral">Admiral</a></li>
            <li><a href="#cert" data-nav="cert">Certificate</a></li>
        </ul>
    }
    else
    {
        <ul class="nav-links">
            <li><a href="/#services">← Back to Deck</a></li>
        </ul>
    }

    <div class="nav-right">
        <button class="theme-toggle" @onclick="ToggleThemeAsync" title="Toggle theme">@(_isDark ? "☀️" : "🌙")</button>
        <button class="hamburger" @onclick="ToggleMobileNav" aria-label="Menu">@(_mobileOpen ? "✕" : "☰")</button>
    </div>
</nav>

<nav class="mobile-nav @(_mobileOpen ? "open" : "")" id="mobileNav">
    @if (IsHome)
    {
        <a href="#stats" @onclick="CloseMobileNav">📊 Ship's Log</a>
        <a href="#services" @onclick="CloseMobileNav">🚢 Deck</a>
        <a href="#admiral" @onclick="CloseMobileNav">⚓ Admiral's Corner</a>
        <a href="#cert" @onclick="CloseMobileNav">🔐 Certificate</a>
    }
    else
    {
        <a href="/" @onclick="CloseMobileNav">🏠 Home</a>
        <a href="/#services" @onclick="CloseMobileNav">🚢 Back to Deck</a>
    }
</nav>

<main>
    @Body
</main>

<footer>
    <div class="footer-brand">⚓ The Hold</div>
    <div>Private · Local Only · thehold.lan</div>
    @if (IsHome)
    {
        <div style="margin-top: 0.5rem; opacity: 0.6;">Crewed by the Flomads · Jordan &amp; the Admiral</div>
    }
</footer>

@code {
    private bool _isDark = true;
    private bool _mobileOpen;

    private bool IsHome => Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/') is "" or "index";

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Reads localStorage/prefers-color-scheme and applies data-theme
            // to <html>; returns which theme ended up active.
            var theme = await JS.InvokeAsync<string>("holdTheme.init");
            _isDark = theme == "dark";
            StateHasChanged();

            await JS.InvokeVoidAsync("holdEffects.init");
        }
    }

    private async Task ToggleThemeAsync()
    {
        _isDark = !_isDark;
        await JS.InvokeVoidAsync("holdTheme.set", _isDark ? "dark" : "light");
    }

    private void ToggleMobileNav() => _mobileOpen = !_mobileOpen;
    private void CloseMobileNav() => _mobileOpen = false;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _mobileOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
